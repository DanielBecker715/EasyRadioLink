<controls:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      x:Class="EasyRadioLink.Client.UI.ClientWindow.InputProfileWindow.InputProfileWindow"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:p="clr-namespace:EasyRadioLink.Client.Properties"
                      Title="{x:Static p:Resources.ProfileWindowTitle}"
                      WindowStartupLocation="CenterOwner"
                      SizeToContent="WidthAndHeight"
                      MinWidth="300"
                      MinHeight="100"
                      WindowStyle="SingleBorderWindow"
                      ResizeMode="CanMinimize">
    <StackPanel Margin="5">
        <Label Content="{x:Static p:Resources.ProfileNamePrompt}" Margin="5" />
        <TextBox Name="ProfileName" Margin="5" />
        <StackPanel Orientation="Horizontal" Margin="5" HorizontalAlignment="Right">
            <Button Content="{x:Static p:Resources.ProfileCreateButton}" IsDefault="True" Margin="5" Name="CreateRename" Click="CreateOrRename_Click" />
            <Button Content="{x:Static p:Resources.BtnCancel}" IsCancel="True" Margin="5" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</controls:MetroWindow>