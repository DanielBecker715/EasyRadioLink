<controls:MetroWindow x:Class="EasyRadioLink.Client.UI.ClientWindow.MainWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:clientWindow="clr-namespace:EasyRadioLink.Client.UI.ClientWindow"
                      xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:converters="clr-namespace:EasyRadioLink.Client.Utils.ValueConverters"
                      xmlns:p="clr-namespace:EasyRadioLink.Client.Properties"
                      xmlns:favourites="clr-namespace:EasyRadioLink.Client.UI.ClientWindow.Favourites"
                      xmlns:inputSettingsControl="clr-namespace:EasyRadioLink.Client.UI.ClientWindow.InputSettingsControl"
                      xmlns:clientSettingsControl="clr-namespace:EasyRadioLink.Client.UI.ClientWindow.ClientSettingsControl"
                      Title="{x:Static p:Resources.ClientWindowTitle}"
                      Width="640"
                      Height="720"
                      d:DataContext="{d:DesignInstance clientWindow:MainWindowViewModel}"
                      ResizeMode="CanMinimize"
                      mc:Ignorable="d">

    <controls:MetroWindow.Resources>
        <converters:MicAvailabilityTooltipConverter x:Key="MicAvailabilityTooltipConverter" />
        <converters:ConnectionStatusImageConverter x:Key="ConnectionStatusImageConverter" />

        <!-- label column of the forms on the Radio tab -->
        <Style x:Key="FormLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="2,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </controls:MetroWindow.Resources>

    <DockPanel LastChildFill="True">

        <!-- status bar: server / voice connection, users online, profile -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem ToolTip="{x:Static p:Resources.ToolTipServerStatus}">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="ServerConnectionStatus"
                           Width="16"
                           Height="16"
                           Source="{Binding Path=IsConnected, Converter={StaticResource ConnectionStatusImageConverter}}" />
                    <TextBlock Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Text="{x:Static p:Resources.ServerConnectionStatusLabel}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem ToolTip="{x:Static p:Resources.ToolTipVoiceStatus}">
                <StackPanel Orientation="Horizontal">
                    <Image x:Name="VOIPConnectionStatus"
                           Width="16"
                           Height="16"
                           Source="{Binding Path=IsVoIPConnected, Converter={StaticResource ConnectionStatusImageConverter}}" />
                    <TextBlock Margin="5,0,0,0"
                               VerticalAlignment="Center"
                               Text="{x:Static p:Resources.VOIPConnectionStatusLabel}" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock x:Name="ClientCount"
                           Text="{Binding Path=Clients.Total, StringFormat={x:Static p:Resources.StatusUsersOnline}}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="CurrentProfile"
                           Margin="0,0,6,0"
                           Text="{Binding Path=CurrentProfile, StringFormat={x:Static p:Resources.StatusProfile}}" />
            </StatusBarItem>
        </StatusBar>

        <TabControl x:Name="TabControl">

            <!-- ============================== Radio ============================== -->
            <TabItem x:Name="RadioTab" Header="{x:Static p:Resources.RadioTab}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="6,6,6,6">

                        <!-- Connection -->
                        <GroupBox Margin="0,0,0,8" Header="{x:Static p:Resources.ConnectionHeader}">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Style="{StaticResource FormLabel}"
                                           Text="{x:Static p:Resources.DisplayNameLabel}" />
                                <TextBox x:Name="DisplayNameBox"
                                         Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="0,3,0,3"
                                         controls:TextBoxHelper.Watermark="{Binding Path=DefaultDisplayName, Mode=OneTime}"
                                         IsEnabled="{Binding IsNotConnected, Mode=OneWay}"
                                         MaxLength="64"
                                         MaxLines="1"
                                         Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{x:Static p:Resources.ToolTipDisplayName}" />

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Style="{StaticResource FormLabel}"
                                           Text="{x:Static p:Resources.Server}" />
                                <Grid Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ServerIp"
                                             Grid.Column="0"
                                             controls:TextBoxHelper.Watermark="{x:Static p:Resources.ServerAddressWatermark}"
                                             IsEnabled="{Binding IsNotConnected, Mode=OneWay}"
                                             MaxLines="1"
                                             Text="{Binding ServerAddress, Mode=TwoWay}"
                                             ToolTip="{x:Static p:Resources.ToolTipServerAddress}" />
                                    <ComboBox x:Name="ServerAddressPicker"
                                              Grid.Column="1"
                                              Margin="6,0,0,0"
                                              controls:TextBoxHelper.Watermark="{x:Static p:Resources.FavouritesWatermark}"
                                              DisplayMemberPath="Name"
                                              IsEnabled="{Binding IsNotConnected, Mode=OneWay}"
                                              ItemsSource="{Binding Path=FavouriteServersViewModel.Addresses}"
                                              SelectedItem="{Binding Path=SelectedServerAddress}"
                                              ToolTip="{x:Static p:Resources.ToolTipFavouritePicker}" />
                                    <Button Grid.Column="2"
                                            Width="30"
                                            Margin="6,0,0,0"
                                            Padding="5"
                                            Click="LaunchAddressTab"
                                            ToolTip="{x:Static p:Resources.ToolTipSavedAddressTab}">
                                        <Path Data="F1 M 0,13.44C 1.28003,12.69 1.92004,11.61 1.92004,10.2C 1.92004,8.94998 1.28003,7.94998 0,7.19998C 0.184998,6.56003 0.45752,5.92001 0.817505,5.28C 2.00751,5.50998 3.09753,5.12253 4.08752,4.11752C 4.95251,3.24252 5.19,2.14499 4.80005,0.824982C 5.45502,0.464996 6.09503,0.190033 6.72003,3.05176e-005C 7.55505,1.28 8.68005,1.92001 10.095,1.92001C 11.47,1.92001 12.585,1.28 13.44,3.05176e-005C 14.065,0.190033 14.705,0.464996 15.36,0.824982C 14.97,2.14499 15.2001,3.24252 16.05,4.11752C 17.04,5.12253 18.1376,5.50998 19.3425,5.28C 19.6525,5.86002 19.9401,6.50003 20.205,7.19998C 18.895,7.95499 18.24,8.95627 18.24,10.2038C 18.24,11.4513 18.895,12.4525 20.205,13.2075C 19.955,13.9025 19.6675,14.54 19.3425,15.12C 18.1525,14.77 17.0551,15.09 16.05,16.08C 15.185,17.005 14.955,18.0925 15.36,19.3425C 14.705,19.7025 14.065,19.9775 13.44,20.1675C 12.605,18.8825 11.49,18.24 10.095,18.24C 8.68005,18.24 7.55505,18.8825 6.72003,20.1675C 6.09503,19.9775 5.45502,19.7025 4.80005,19.3425C 5.19,18.0925 4.95251,17.01 4.08752,16.095C 3.22253,15.24 2.13251,14.995 0.817505,15.36C 0.45752,14.72 0.184998,14.08 0,13.44 Z M 6.97504,7.04251C 6.16504,7.89749 5.76001,8.94998 5.76001,10.2C 5.76001,11.45 6.16626,12.4625 6.97876,13.2375C 7.79126,14.0125 8.83374,14.4 10.1063,14.4C 11.3788,14.4 12.4125,14.0125 13.2075,13.2375C 14.0025,12.4625 14.4,11.45 14.4,10.2C 14.4,8.94998 14.0025,7.89749 13.2075,7.04251C 12.4125,6.18753 11.3788,5.75998 10.1063,5.75998C 8.83374,5.75998 7.79004,6.18753 6.97504,7.04251 Z "
                                              Fill="{DynamicResource MahApps.Brushes.Gray1}"
                                              Stretch="Uniform"
                                              UseLayoutRounding="False" />
                                    </Button>
                                </Grid>

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Style="{StaticResource FormLabel}"
                                           Text="{x:Static p:Resources.ServerPasswordLabel}" />
                                <PasswordBox x:Name="ServerPasswordBox"
                                             Grid.Row="2"
                                             Grid.Column="1"
                                             Margin="0,3,0,3"
                                             controls:TextBoxHelper.Watermark="{x:Static p:Resources.ServerPasswordWatermark}"
                                             IsEnabled="{Binding IsNotConnected, Mode=OneWay}"
                                             ToolTip="{x:Static p:Resources.ToolTipServerPassword}" />

                                <StackPanel Grid.Row="3"
                                            Grid.Column="1"
                                            Margin="0,8,0,2"
                                            Orientation="Horizontal">
                                    <Button x:Name="StartStop"
                                            Width="150"
                                            controls:ControlsHelper.ContentCharacterCasing="Upper"
                                            Command="{Binding Path=ConnectCommand}"
                                            Content="{Binding Path=ConnectText}"
                                            IsEnabled="{Binding ConnectIsEnabled}"
                                            Style="{StaticResource MahApps.Styles.Button.Square.Accent}"
                                            ToolTip="{Binding Path=AudioInput.MicrophoneAvailable, Converter={StaticResource MicAvailabilityTooltipConverter}}"
                                            ToolTipService.ShowOnDisabled="True" />
                                    <Button x:Name="ToggleServerSettings"
                                            Width="150"
                                            Margin="8,0,0,0"
                                            Command="{Binding Path=ServerSettingsCommand}"
                                            Content="{x:Static p:Resources.ToggleServerSettings}"
                                            IsEnabled="{Binding IsConnected}"
                                            ToolTip="{x:Static p:Resources.ToolTipServerInfo}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Radios -->
                        <GroupBox Margin="0,0,0,8" Header="{x:Static p:Resources.RadiosHeader}">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            Margin="0,2,0,2"
                                            Orientation="Horizontal">
                                    <Button x:Name="ShowRadioPanel"
                                            Width="150"
                                            Command="{Binding RadioPanelCommand}"
                                            Content="{x:Static p:Resources.ShowRadioPanel}"
                                            ToolTip="{x:Static p:Resources.ToolTipRadioPanel}" />
                                    <Button x:Name="ShowClientList"
                                            Width="150"
                                            Margin="8,0,0,0"
                                            Command="{Binding ClientListCommand}"
                                            Content="{Binding UsersButtonText}"
                                            IsEnabled="{Binding IsConnected}"
                                            ToolTip="{x:Static p:Resources.ToolTipClientList}" />
                                </StackPanel>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="2,8,10,0"
                                           Style="{StaticResource FormLabel}"
                                           Text="{x:Static p:Resources.PresetsFolderLabel}" />
                                <Grid Grid.Row="1"
                                      Grid.Column="1"
                                      Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label x:Name="PresetsFolderLabel"
                                           Grid.Column="0"
                                           Padding="0"
                                           VerticalContentAlignment="Center" />
                                    <Button x:Name="PresetsFolderBrowseButton"
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Click="PresetsFolderBrowseButton_Click"
                                            Content="{x:Static p:Resources.PresetsFolderBrowseButton}"
                                            IsEnabled="{Binding IsNotConnected, Mode=OneWay}"
                                            ToolTip="{x:Static p:Resources.ToolTipPresetsFolder}" />
                                    <Button x:Name="PresetsFolderResetButton"
                                            Grid.Column="2"
                                            Margin="6,0,0,0"
                                            Click="PresetsFolderResetButton_Click"
                                            Content="{x:Static p:Resources.PresetsFolderResetButton}"
                                            IsEnabled="{Binding IsNotConnected, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                        </GroupBox>

                        <!-- Audio devices -->
                        <GroupBox Margin="0,0,0,4" Header="{x:Static p:Resources.SetupHeader}">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- microphone + level + preview -->
                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Style="{StaticResource FormLabel}"
                                           Text="{x:Static p:Resources.MicLabel}" />
                                <ComboBox x:Name="Mic"
                                          Grid.Row="0"
                                          Grid.Column="1"
                                          Grid.ColumnSpan="2"
                                          Margin="0,3,0,3"
                                          IsEnabled="{Binding AudioSettingsEnabled}"
                                          ItemsSource="{Binding Path=AudioInput.InputAudioDevices}"
                                          SelectedItem="{Binding Path=AudioInput.SelectedAudioInput, Mode=TwoWay}"
                                          ToolTip="{Binding Path=AudioInput.MicrophoneAvailable, Converter={StaticResource MicAvailabilityTooltipConverter}}" />

                                <ProgressBar Name="Mic_VU"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             Height="14"
                                             Margin="0,3,0,3"
                                             VerticalAlignment="Center"
                                             Maximum="18"
                                             Minimum="-100"
                                             ToolTip="{Binding Path=AudioInput.MicrophoneAvailable, Converter={StaticResource MicAvailabilityTooltipConverter}}"
                                             Value="{Binding MicVU, Mode=OneWay}" />

                                <TextBlock Grid.Row="2"
                                           Grid.Column="0"
                                           Style="{StaticResource FormLabel}"
                                           Text="{x:Static p:Resources.PreviewModelLabel}" />
                                <ComboBox x:Name="PreviewModel"
                                          Grid.Row="2"
                                          Grid.Column="1"
                                          Margin="0,3,0,3"
                                          DisplayMemberPath="DisplayName"
                                          IsEnabled="{Binding AudioSettingsEnabled}"
                                          ItemsSource="{Binding PreviewModels}"
                                          SelectedValue="{Binding PreviewModelKey, Mode=TwoWay}"
                                          SelectedValuePath="Key"
                                          ToolTip="{x:Static p:Resources.ToolTipPreviewModel}" />
                                <Button x:Name="Preview"
                                        Grid.Row="2"
                                        Grid.Column="2"
                                        Width="130"
                                        Margin="8,3,0,3"
                                        Command="{Binding PreviewCommand}"
                                        Content="{Binding PreviewText}"
                                        IsEnabled="{Binding PreviewEnabled}"
                                        ToolTip="{Binding Path=AudioInput.MicrophoneAvailable, Converter={StaticResource MicAvailabilityTooltipConverter}}"
                                        ToolTipService.ShowOnDisabled="True" />

                                <!-- speakers + optional mic output -->
                                <TextBlock Grid.Row="3"
                                           Grid.Column="0"
                                           Style="{StaticResource FormLabel}"
                                           Text="{x:Static p:Resources.SpeakerLabel}" />
                                <ComboBox x:Name="Speakers"
                                          Grid.Row="3"
                                          Grid.Column="1"
                                          Grid.ColumnSpan="2"
                                          Margin="0,3,0,3"
                                          IsEnabled="{Binding AudioSettingsEnabled}"
                                          ItemsSource="{Binding Path=AudioOutput.OutputAudioDevices}"
                                          SelectedItem="{Binding Path=AudioOutput.SelectedAudioOutput, Mode=TwoWay}" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="0"
                                           Style="{StaticResource FormLabel}"
                                           Text="{x:Static p:Resources.MicOutputLabel}" />
                                <ComboBox x:Name="MicOutput"
                                          Grid.Row="4"
                                          Grid.Column="1"
                                          Grid.ColumnSpan="2"
                                          Margin="0,3,0,3"
                                          IsEnabled="{Binding AudioSettingsEnabled}"
                                          ItemsSource="{Binding Path=AudioOutput.MicOutputAudioDevices}"
                                          SelectedItem="{Binding Path=AudioOutput.SelectedMicAudioOutput, Mode=TwoWay}"
                                          ToolTip="{x:Static p:Resources.ToolTipMicOutput}" />

                                <!-- speaker boost + level -->
                                <TextBlock Grid.Row="5"
                                           Grid.Column="0"
                                           Style="{StaticResource FormLabel}"
                                           Text="{x:Static p:Resources.SpeakerBoost}" />
                                <Grid Grid.Row="5"
                                      Grid.Column="1"
                                      Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            IsMoveToPointEnabled="True"
                                            Maximum="1.0"
                                            Minimum="0.0"
                                            ToolTip="{x:Static p:Resources.ToolTipSpeakerBoost}"
                                            Value="{Binding Path=SpeakerBoost, Mode=TwoWay}" />
                                    <ProgressBar Grid.Column="1"
                                                 Height="14"
                                                 VerticalAlignment="Center"
                                                 Maximum="18"
                                                 Minimum="-100"
                                                 Value="{Binding Path=SpeakerVU, Mode=OneWay}" />
                                </Grid>
                                <TextBlock x:Name="SpeakerBoostLabel"
                                           Grid.Row="5"
                                           Grid.Column="2"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding SpeakerBoostText}" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================== Controls ============================== -->
            <TabItem Header="{x:Static p:Resources.ControlsTab}">
                <GroupBox x:Name="ControlsGroupBox"
                          Margin="6"
                          Header="{x:Static p:Resources.ControlsHeader}">
                    <inputSettingsControl:InputSettings />
                </GroupBox>
            </TabItem>

            <!-- ============================== Favourites ============================== -->
            <TabItem x:Name="FavouritesSeversTab" Header="{x:Static p:Resources.FavouritesSeversTab}">
                <GroupBox Margin="6" Header="{x:Static p:Resources.FavouritesSeversHeader}">
                    <favourites:FavouriteServersView x:Name="FavouriteServersView"
                                                     DataContext="{Binding Path=FavouriteServersViewModel}" />
                </GroupBox>
            </TabItem>

            <!-- ============================== Settings ============================== -->
            <TabItem Header="{x:Static p:Resources.SettingsTab}">
                <clientSettingsControl:ClientSettings />
            </TabItem>

            <!-- ============================== About ============================== -->
            <TabItem Header="{x:Static p:Resources.AboutTab}">
                <FlowDocumentScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <FlowDocument x:Name="AboutFlowDocument"
                                  FontFamily="Segoe UI"
                                  FontSize="13"
                                  PagePadding="16,12,16,12"
                                  TextAlignment="Left">
                        <FlowDocument.Resources>
                            <Style x:Key="AboutHeader" TargetType="{x:Type Paragraph}">
                                <Setter Property="Margin" Value="0,16,0,4" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                            <Style TargetType="{x:Type List}">
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="Padding" Value="22,0,0,0" />
                            </Style>
                            <Style TargetType="{x:Type ListItem}">
                                <Setter Property="Margin" Value="0,0,0,4" />
                            </Style>
                        </FlowDocument.Resources>

                        <Paragraph Margin="0" FontSize="22" FontWeight="SemiBold">
                            <Run x:Name="AboutProductRun" Text="EasyRadioLink" />
                        </Paragraph>
                        <Paragraph Margin="0,0,0,10" Foreground="Gray">
                            <Run x:Name="AboutVersionRun" Text="" />
                        </Paragraph>
                        <Paragraph Margin="0">
                            <Run Text="{x:Static p:Resources.AboutDescription}" />
                        </Paragraph>

                        <Paragraph Style="{StaticResource AboutHeader}">
                            <Run Text="{x:Static p:Resources.AboutQuickStartHeader}" />
                        </Paragraph>
                        <List MarkerStyle="Decimal">
                            <ListItem>
                                <Paragraph>
                                    <Run Text="{x:Static p:Resources.AboutQuickStart1}" />
                                </Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>
                                    <Run Text="{x:Static p:Resources.AboutQuickStart2}" />
                                </Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>
                                    <Run Text="{x:Static p:Resources.AboutQuickStart3}" />
                                </Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>
                                    <Run Text="{x:Static p:Resources.AboutQuickStart4}" />
                                </Paragraph>
                            </ListItem>
                        </List>

                        <Paragraph Style="{StaticResource AboutHeader}">
                            <Run Text="{x:Static p:Resources.AboutTipsHeader}" />
                        </Paragraph>
                        <List MarkerStyle="Disc">
                            <ListItem>
                                <Paragraph>
                                    <Run Text="{x:Static p:Resources.AboutTipAudio}" />
                                </Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>
                                    <Run Text="{x:Static p:Resources.AboutTipRadioPanel}" />
                                </Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>
                                    <Run Text="{x:Static p:Resources.AboutTipPresets}" />
                                </Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>
                                    <Run Text="{x:Static p:Resources.AboutTipRadios}" />
                                </Paragraph>
                            </ListItem>
                            <ListItem>
                                <Paragraph>
                                    <Run Text="{x:Static p:Resources.AboutTipInputDevices}" />
                                </Paragraph>
                            </ListItem>
                        </List>

                        <Paragraph Style="{StaticResource AboutHeader}">
                            <Run Text="{x:Static p:Resources.AboutFilesHeader}" />
                        </Paragraph>
                        <Paragraph Margin="0">
                            <Run Text="{x:Static p:Resources.AboutSettingsFolder}" />
                            <Hyperlink x:Name="ConfigFolderLink">
                                <Run x:Name="ConfigFolderRun" />
                            </Hyperlink>
                            <LineBreak />
                            <Run Text="{x:Static p:Resources.AboutLogFolder}" />
                            <Hyperlink x:Name="LogFolderLink">
                                <Run x:Name="LogFolderRun" />
                            </Hyperlink>
                            <LineBreak />
                            <Run Text="{x:Static p:Resources.AboutRecordingsFolder}" />
                            <Hyperlink x:Name="RecordingsFolderLink">
                                <Run x:Name="RecordingsFolderRun" />
                            </Hyperlink>
                            <LineBreak />
                            <Run Text="{x:Static p:Resources.AboutRadioModelsFolder}" />
                            <Hyperlink x:Name="RadioModelsFolderLink">
                                <Run x:Name="RadioModelsFolderRun" />
                            </Hyperlink>
                        </Paragraph>

                        <Paragraph Style="{StaticResource AboutHeader}">
                            <Run Text="{x:Static p:Resources.AboutLicenseHeader}" />
                        </Paragraph>
                        <Paragraph Margin="0,0,0,8">
                            <Run Text="{x:Static p:Resources.AboutLicense}" />
                            <Hyperlink NavigateUri="https://www.gnu.org/licenses/gpl-3.0.html">
                                <Run Text="{x:Static p:Resources.AboutLicenseLink}" />
                            </Hyperlink>
                        </Paragraph>
                        <Paragraph Margin="0,0,0,8">
                            <Run Text="{x:Static p:Resources.AboutCredit}" />
                        </Paragraph>
                        <Paragraph Margin="0">
                            <Run Text="{x:Static p:Resources.AboutSourceCode}" />
                            <Hyperlink NavigateUri="https://github.com/DanielBecker715/EasyRadioLink">
                                <Run Text="https://github.com/DanielBecker715/EasyRadioLink" />
                            </Hyperlink>
                        </Paragraph>
                    </FlowDocument>
                </FlowDocumentScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</controls:MetroWindow>
