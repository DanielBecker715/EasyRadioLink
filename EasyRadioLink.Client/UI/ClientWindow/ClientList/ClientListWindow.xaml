<controls:MetroWindow x:Class="EasyRadioLink.Client.UI.ClientWindow.ClientList.ClientListWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:clientList="clr-namespace:EasyRadioLink.Client.UI.ClientWindow.ClientList"
                      xmlns:p="clr-namespace:EasyRadioLink.Client.Properties"
                      Title="{x:Static p:Resources.ClientListTitle}"
                      Width="460"
                      Height="520"
                      MinWidth="360"
                      MinHeight="250"
                      ResizeMode="CanResizeWithGrip"
                      mc:Ignorable="d">
    <DockPanel Margin="8" LastChildFill="True">

        <TextBlock x:Name="ClientCountText"
                   Margin="2,0,2,6"
                   DockPanel.Dock="Top"
                   Style="{StaticResource HintText}" />

        <!-- column headers: name | recording allowed | muted | mute button -->
        <Grid Margin="6,0,6,4" DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="80" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="80" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       FontWeight="SemiBold"
                       Text="{x:Static p:Resources.ClientListName}" />
            <TextBlock Grid.Column="1"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{x:Static p:Resources.ClientListRecording}"
                       ToolTip="{x:Static p:Resources.ToolTipClientListRecording}" />
            <TextBlock Grid.Column="2"
                       HorizontalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{x:Static p:Resources.ClientListMuted}" />
        </Grid>

        <ListBox Name="ClientList"
                 HorizontalContentAlignment="Stretch"
                 d:DataContext="{d:DesignInstance clientList:ClientListItem}"
                 BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="clientList:ClientListItem">
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding DisplayName}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding DisplayName}" />
                        <TextBlock Grid.Column="1"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding RecordingText}" />
                        <TextBlock Grid.Column="2"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding IsMuted}" />
                        <Button Grid.Column="3"
                                Margin="4,0,0,0"
                                Command="{Binding ToggleMute}"
                                Content="{Binding MuteButtonText}"
                                IsEnabled="{Binding CanMute}"
                                ToolTip="{x:Static p:Resources.ToolTipClientListMute}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</controls:MetroWindow>
