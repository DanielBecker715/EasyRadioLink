<UserControl x:Class="EasyRadioLink.Client.UI.ClientWindow.Favourites.FavouriteServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:favourites="clr-namespace:EasyRadioLink.Client.UI.ClientWindow.Favourites"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:p="clr-namespace:EasyRadioLink.Client.Properties"
             xmlns:converters="clr-namespace:EasyRadioLink.Client.Utils.ValueConverters"
             xmlns:favourites1="clr-namespace:EasyRadioLink.Client.Settings.Favourites"
             d:DataContext="{d:DesignInstance favourites:FavouriteServersViewModel,
                                              IsDesignTimeCreatable=False}"
             d:DesignHeight="400"
             d:DesignWidth="580"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:PasswordMaskConverter x:Key="PasswordMaskConverter" />
    </UserControl.Resources>

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource HintText}"
                   Text="{x:Static p:Resources.FavTitle}" />

        <!-- add a server: name, address, optional password -->
        <Grid Grid.Row="1" Margin="0,4,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="4*" />
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Margin="0,0,0,2"
                       Text="{x:Static p:Resources.FavAddName}" />
            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       Margin="6,0,0,2"
                       Text="{x:Static p:Resources.FavAddServer}" />
            <TextBlock Grid.Row="0"
                       Grid.Column="2"
                       Margin="6,0,0,2"
                       Text="{x:Static p:Resources.FavAddPassword}" />

            <TextBox Grid.Row="1"
                     Grid.Column="0"
                     mah:TextBoxHelper.Watermark="{x:Static p:Resources.FavNameWatermark}"
                     Text="{Binding Path=NewName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Margin="6,0,0,0"
                     mah:TextBoxHelper.Watermark="{x:Static p:Resources.ServerAddressWatermark}"
                     Text="{Binding Path=NewAddress, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Row="1"
                     Grid.Column="2"
                     Margin="6,0,0,0"
                     mah:TextBoxHelper.Watermark="{x:Static p:Resources.ServerPasswordWatermark}"
                     Text="{Binding Path=NewPassword, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{x:Static p:Resources.ToolTipServerPassword}" />
            <Button Grid.Row="1"
                    Grid.Column="3"
                    Margin="6,0,0,0"
                    Command="{Binding Path=NewAddressCommand}"
                    Content="{x:Static p:Resources.FavAdd}"
                    ToolTip="{x:Static p:Resources.ToolTipFavAdd}" />
        </Grid>

        <DataGrid Name="FavouritesGrid"
                  Grid.Row="2"
                  AllowDrop="True"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  ItemsSource="{Binding Path=Addresses}"
                  SelectedItem="{Binding Path=SelectedItem}"
                  SelectionMode="Single">

            <DataGrid.RowStyle>
                <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="{x:Type DataGridRow}">
                    <EventSetter Event="MouseMove" Handler="DataGridRow_MouseMove" />
                    <EventSetter Event="Drop" Handler="DataGridRow_Drop" />
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Width="3*"
                                    Binding="{Binding Path=Name}"
                                    Header="{x:Static p:Resources.FavListName}" />
                <DataGridTextColumn Width="4*"
                                    Binding="{Binding Path=Address}"
                                    Header="{x:Static p:Resources.FavListServer}" />
                <!-- the password is masked; double-click to edit -->
                <DataGridTemplateColumn Width="3*" Header="{x:Static p:Resources.FavListPassword}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="favourites1:ServerAddress">
                            <TextBlock Margin="4,0,4,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding Path=Password, Converter={StaticResource PasswordMaskConverter}}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate DataType="favourites1:ServerAddress">
                            <TextBox Text="{Binding Path=Password, UpdateSourceTrigger=LostFocus}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Width="Auto" Header="{x:Static p:Resources.FavListDefault}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="favourites1:ServerAddress">

                            <Button Name="Button"
                                    Padding="0"
                                    Command="{Binding ElementName=FavouritesGrid, Path=DataContext.OnDefaultChangedCommand}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{x:Static p:Resources.ToolTipFavDefault}" />

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Path=IsDefault}" Value="True">
                                    <DataTrigger.Setters>
                                        <Setter TargetName="Button" Property="Content">
                                            <Setter.Value>
                                                <Path Height="15"
                                                      Data="F1 M 5.33334,3.05176e-005C 8.27869,3.05176e-005 10.6667,2.38669 10.6667,5.33334L 10.6667,128C 10.6667,130.947 8.27869,133.333 5.33334,133.333C 2.38669,133.333 0,130.947 0,128L 0,5.33334C 0,2.38669 2.38669,3.05176e-005 5.33334,3.05176e-005 Z M 58.4986,3.84378C 65.2643,6.4642 70.6588,8.52805 80,4.45712L 80,44.6909C 70.2527,48.5827 64.0612,46.1921 57.5364,43.664C 52.8828,41.8627 48.0729,40 41.3333,40C 27.6667,40 17.9681,48.1263 16,49.9122L 16,9.08273C 20.028,5.89725 29.1282,3.05176e-005 41.3333,3.05176e-005C 48.5703,3.05176e-005 53.845,2.04163 58.4986,3.84378 Z "
                                                      Fill="{DynamicResource MahApps.Brushes.Gray1}"
                                                      Stretch="Uniform" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger.Setters>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="3"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Command="{Binding Path=RemoveSelectedCommand}"
                Content="{x:Static p:Resources.FavRmSelected}" />
    </Grid>

</UserControl>
