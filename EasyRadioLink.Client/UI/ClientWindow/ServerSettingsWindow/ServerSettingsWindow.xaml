<controls:MetroWindow
    x:Class="EasyRadioLink.Client.UI.ClientWindow.ServerSettingsWindow.ServerSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:p="clr-namespace:EasyRadioLink.Client.Properties"
    Title="{x:Static p:Resources.ServerWindowTitle}"
    Width="480"
    ResizeMode="NoResize"
    SizeToContent="Height">

    <controls:MetroWindow.Resources>
        <Style x:Key="InfoValue" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,5,4,5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Text" Value="{x:Static p:Resources.ValueUnknown}" />
        </Style>
    </controls:MetroWindow.Resources>

    <StackPanel Margin="12,8,12,12" Orientation="Vertical">
        <TextBlock Style="{StaticResource HintText}" Text="{x:Static p:Resources.ServerInfoHint}" />

        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource SettingText}"
                       Text="{x:Static p:Resources.SrvRealRadio}" />
            <TextBlock x:Name="RealRadio"
                       Grid.Row="0"
                       Grid.Column="1"
                       Style="{StaticResource InfoValue}" />

            <TextBlock Grid.Row="1"
                       Style="{StaticResource SettingText}"
                       Text="{x:Static p:Resources.SrvRadioRXInterference}" />
            <TextBlock x:Name="RadioRXInterference"
                       Grid.Row="1"
                       Grid.Column="1"
                       Style="{StaticResource InfoValue}" />

            <TextBlock Grid.Row="2"
                       Style="{StaticResource SettingText}"
                       Text="{x:Static p:Resources.SrvBusyChannelLockout}" />
            <TextBlock x:Name="BusyChannelLockout"
                       Grid.Row="2"
                       Grid.Column="1"
                       Style="{StaticResource InfoValue}" />

            <TextBlock Grid.Row="3"
                       Style="{StaticResource SettingText}"
                       Text="{x:Static p:Resources.SrvTunedClientCount}" />
            <TextBlock x:Name="TunedClientCount"
                       Grid.Row="3"
                       Grid.Column="1"
                       Style="{StaticResource InfoValue}" />

            <TextBlock Grid.Row="4"
                       Style="{StaticResource SettingText}"
                       Text="{x:Static p:Resources.SrvShowTransmitterName}" />
            <TextBlock x:Name="ShowTransmitterName"
                       Grid.Row="4"
                       Grid.Column="1"
                       Style="{StaticResource InfoValue}" />

            <TextBlock Grid.Row="5"
                       Style="{StaticResource SettingText}"
                       Text="{x:Static p:Resources.SrvTestFrequencies}" />
            <TextBlock x:Name="TestFrequencies"
                       Grid.Row="5"
                       Grid.Column="1"
                       Style="{StaticResource InfoValue}" />

            <TextBlock Grid.Row="6"
                       Style="{StaticResource SettingText}"
                       Text="{x:Static p:Resources.SrvCleanFrequencies}" />
            <TextBlock x:Name="CleanFrequencies"
                       Grid.Row="6"
                       Grid.Column="1"
                       Style="{StaticResource InfoValue}" />

            <TextBlock Grid.Row="7"
                       Style="{StaticResource SettingText}"
                       Text="{x:Static p:Resources.SrvServerVersion}" />
            <TextBlock x:Name="ServerVersion"
                       Grid.Row="7"
                       Grid.Column="1"
                       Style="{StaticResource InfoValue}" />
        </Grid>

        <!-- the pinned (and verified) server identity - selectable so users can copy and compare it -->
        <TextBlock Margin="4,10,12,2"
                   Style="{StaticResource SettingText}"
                   Text="{x:Static p:Resources.SrvServerIdentity}" />
        <TextBox x:Name="ServerIdentityFingerprint"
                 Margin="4,0,4,2"
                 Padding="0"
                 Background="Transparent"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontWeight="SemiBold"
                 IsReadOnly="True"
                 IsTabStop="False"
                 TextWrapping="Wrap"
                 Text="{x:Static p:Resources.ValueUnknown}" />
        <TextBlock Style="{StaticResource HintText}" Text="{x:Static p:Resources.SrvServerIdentityHint}" />

        <Button Width="100"
                Margin="0,12,0,0"
                HorizontalAlignment="Right"
                Click="CloseButton_OnClick"
                Content="{x:Static p:Resources.BtnClose}"
                IsCancel="True" />
    </StackPanel>
</controls:MetroWindow>
