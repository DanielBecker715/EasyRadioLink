<UserControl
    x:Class="EasyRadioLink.Client.UI.ClientWindow.ClientSettingsControl.BackgroundEffectVolumeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800"
    Name="EffectsVolumeControl">
    <!-- same margins as the other sliders of the Settings tab -->
    <StackPanel
        Margin="0,4,10,4">

        <Slider x:Name="EffectVolume"
                TickPlacement="BottomRight"
                SmallChange="5"
                LargeChange="10"
                IsSnapToTickEnabled="True"
                TickFrequency="{Binding TickStep, RelativeSource={RelativeSource AncestorType=UserControl}}"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                Minimum="0"
                Maximum="{Binding MaximumPercentage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Value="{Binding ElementName=EffectsVolumeControl, Path=VolumeValue, Mode=TwoWay}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" FontSize="10" Text="0%" HorizontalAlignment="Left" />
            <TextBlock Grid.Column="1" FontSize="10"
                       Text="{Binding HalfMaximumPercentage, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0}%}"
                       HorizontalAlignment="Center" />
            <TextBlock Grid.Column="2" FontSize="10"
                       Text="{Binding MaximumPercentage, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0}%}"
                       HorizontalAlignment="Right" />
        </Grid>

    </StackPanel>
</UserControl>