<UserControl
    x:Class="EasyRadioLink.Client.UI.ClientWindow.ClientSettingsControl.SettingsToggleControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:p="clr-namespace:EasyRadioLink.Client.Properties"
    mc:Ignorable="d"
    Width="100"
    Name="ToggleSettingsControl">

    <mah:ToggleSwitch
        Name="Toggle"
        Width="100"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        IsOn="{Binding ElementName=ToggleSettingsControl, Path=ToggleValue, Mode=TwoWay}"
        OffContent="{x:Static p:Resources.ToggleOff}"
        OnContent="{x:Static p:Resources.ToggleOn}" />

</UserControl>
