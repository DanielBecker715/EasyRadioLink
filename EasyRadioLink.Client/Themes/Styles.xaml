<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shared styles of the main window and its dialogs (MahApps light theme, see App.xaml). The radio window
        (UI/ClientWindow/RadioPanel/RadioPanelWindow.xaml) brings its own styles.
    -->

    <!-- Main window: label text of a settings row (left column) -->
    <Style x:Key="SettingText" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="4,6,12,6" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Main window: explanatory text below a group header -->
    <Style x:Key="HintText" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="4,2,4,6" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray2}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Main window: a section title inside a group (e.g. the Controls tab) -->
    <Style x:Key="SectionText" TargetType="{x:Type TextBlock}">
        <Setter Property="Margin" Value="4,10,4,4" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
    </Style>

</ResourceDictionary>
