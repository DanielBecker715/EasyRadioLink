<UserControl x:Class="EasyRadioLink.Server.UI.MainWindow.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:p="clr-namespace:EasyRadioLink.Server.Properties"
             Width="420"
             Height="560"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,4,5,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="SettingButton" TargetType="Button">
            <Setter Property="Width" Value="75" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SettingTextBox" TargetType="TextBox">
            <Setter Property="Width" Value="130" />
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
        <StackPanel Orientation="Vertical" Margin="5">
            <!-- Status -->
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="ServerStartStop"
                        Width="90"
                        Height="22"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Content="{Binding ServerButtonText}" />

                <StackPanel Orientation="Vertical" Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <Label Width="55"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Content="{x:Static p:Resources.LabelClients}" />
                        <Label x:Name="ClientsCount"
                               Width="60"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Content="0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label Width="55"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Content="{x:Static p:Resources.LabelPort}" />
                        <Label x:Name="ListeningPort"
                               Width="60"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               Content="5010" />
                    </StackPanel>
                </StackPanel>

                <Button x:Name="ShowClientList"
                        Grid.Column="2"
                        Width="90"
                        Height="22"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Content="{x:Static p:Resources.BtnClientAdmin}" />
            </Grid>

            <!-- Settings -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="140" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- Access -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelServerPassword}"
                           ToolTip="{x:Static p:Resources.TooltipServerPassword}" />
                <TextBox x:Name="ServerPassword"
                         Grid.Row="0" Grid.Column="1"
                         Style="{StaticResource SettingTextBox}"
                         Text="{Binding ServerPassword, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static p:Resources.TooltipServerPassword}" />

                <!-- Radio realism -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelRadioEncryption}"
                           ToolTip="{x:Static p:Resources.TooltipRadioEncryption}" />
                <Button x:Name="AllowRadioEncryptionToggle"
                        Grid.Row="1" Grid.Column="1"
                        Style="{StaticResource SettingButton}"
                        Content="{Binding AllowRadioEncryption}" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelStrictEncryption}"
                           ToolTip="{x:Static p:Resources.TooltipStrictEncryption}" />
                <Button x:Name="StrictRadioEncryptionToggle"
                        Grid.Row="2" Grid.Column="1"
                        Style="{StaticResource SettingButton}"
                        Content="{Binding StrictRadioEncryption}" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelRealTx}"
                           ToolTip="{x:Static p:Resources.TooltipRealTx}" />
                <Button x:Name="RealRadioToggle"
                        Grid.Row="3" Grid.Column="1"
                        Style="{StaticResource SettingButton}"
                        Content="{Binding RealRadioText}" />

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelRealRx}"
                           ToolTip="{x:Static p:Resources.TooltipRealRx}" />
                <Button x:Name="IRLRadioRxBehaviourToggle"
                        Grid.Row="4" Grid.Column="1"
                        Style="{StaticResource SettingButton}"
                        Content="{Binding IRLRadioRxText}" />

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelTestFreq}"
                           ToolTip="{x:Static p:Resources.TooltipTestFreq}" />
                <TextBox x:Name="TestFrequencies"
                         Grid.Row="5" Grid.Column="1"
                         Style="{StaticResource SettingTextBox}"
                         Text="{Binding TestFrequencies, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static p:Resources.TooltipTestFreq}" />

                <TextBlock Grid.Row="6" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelCleanFreq}"
                           ToolTip="{x:Static p:Resources.TooltipCleanFreq}" />
                <TextBox x:Name="CleanFrequencies"
                         Grid.Row="6" Grid.Column="1"
                         Style="{StaticResource SettingTextBox}"
                         Text="{Binding CleanFrequencies, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static p:Resources.TooltipCleanFreq}" />

                <!-- Features -->
                <TextBlock Grid.Row="7" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelTunedCount}"
                           ToolTip="{x:Static p:Resources.TooltipTunedCount}" />
                <Button x:Name="TunedCountToggle"
                        Grid.Row="7" Grid.Column="1"
                        Style="{StaticResource SettingButton}"
                        Content="{Binding TunedCountText}" />

                <TextBlock Grid.Row="8" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelShowTransmitterName}" />
                <Button x:Name="ShowTransmitterNameToggle"
                        Grid.Row="8" Grid.Column="1"
                        Style="{StaticResource SettingButton}"
                        Content="{Binding ShowTransmitterNameText}" />

                <TextBlock Grid.Row="9" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelServerPresets}"
                           ToolTip="{x:Static p:Resources.TooltipServerPresets}" />
                <Button x:Name="ServerPresetsEnabledToggle"
                        Grid.Row="9" Grid.Column="1"
                        Style="{StaticResource SettingButton}"
                        Content="{Binding ServerPresetsEnabledText}" />

                <TextBlock Grid.Row="10" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelServerRadioPreset}"
                           ToolTip="{x:Static p:Resources.TooltipServerRadioPreset}" />
                <Button x:Name="ServerRadioPresetEnabledToggle"
                        Grid.Row="10" Grid.Column="1"
                        Style="{StaticResource SettingButton}"
                        Content="{Binding ServerRadioPresetEnabledText}" />

                <!-- Logging / export -->
                <TextBlock Grid.Row="11" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelExportList}" />
                <Button x:Name="ExportListToggle"
                        Grid.Row="11" Grid.Column="1"
                        Style="{StaticResource SettingButton}"
                        Content="{Binding ExportListText}" />

                <TextBlock Grid.Row="12" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelTransmissionLog}" />
                <Button x:Name="TransmissionLogEnabledToggle"
                        Grid.Row="12" Grid.Column="1"
                        Style="{StaticResource SettingButton}"
                        Content="{Binding TransmissionLogEnabledText}" />

                <TextBlock Grid.Row="13" Grid.Column="0"
                           Style="{StaticResource SettingLabel}"
                           Text="{x:Static p:Resources.LabelArchiveTime}" />
                <StackPanel Orientation="Vertical"
                            Grid.Row="13"
                            Grid.Column="1">
                    <Grid Width="75">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Label Grid.Column="0" FontSize="10" Content="0" HorizontalAlignment="Left" />
                        <Label HorizontalAlignment="Right" Grid.Column="1" FontSize="10" Content="7" />
                    </Grid>

                    <Slider
                        Value="{Binding ArchiveLimit}"
                        Width="75"
                        Height="40"
                        VerticalAlignment="Center"
                        Interval="1"
                        Minimum="0"
                        Maximum="7"
                        Ticks="1,2,3,4,5,6,7"
                        TickPlacement="TopLeft"
                        IsSnapToTickEnabled="True"
                        HorizontalAlignment="Center">
                    </Slider>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
